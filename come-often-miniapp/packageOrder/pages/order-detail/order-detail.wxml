<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view wx:if="{{order}}" class="page">
  <view class="code-card">
    <text class="code-label">{{order.orderType === 'DINE_IN' ? '到店核销码' : '取餐码'}}</text>
    <text class="code-value">{{order.pickupCode || '—'}}</text>
    <text class="code-status">{{order.statusText}}</text>
    <text wx:if="{{order.depositNote}}" class="code-note">{{order.depositNote}}</text>
    <text wx:if="{{order.status === 'REFUNDING'}}" class="code-note">退款审核中，请等待商家处理</text>
    <text wx:if="{{order.status === 'REFUNDED'}}" class="code-note">已退款，款项按原渠道退回</text>
    <text wx:if="{{order.containsPreorder && (order.status === 'PAID' || order.status === 'ACCEPTED' || order.status === 'READY')}}" class="code-note">定金订单如需退款请联系门店处理</text>
  </view>

  <view class="section-card">
    <text class="card-title">金额明细（下单快照）</text>
    <view class="amount-row"><text>商品总额</text><text>¥{{order.totalAmount}}</text></view>
    <view wx:if="{{order.discountAmount > 0}}" class="amount-row"><text>券抵扣</text><text>-¥{{order.discountAmount}}</text></view>
    <view wx:if="{{order.pointsAmount > 0}}" class="amount-row"><text>积分抵现</text><text>-¥{{order.pointsAmount}}</text></view>
    <view wx:if="{{order.containsPreorder}}" class="amount-row"><text>定金（整单内抵扣）</text><text>¥{{order.depositAmount}}</text></view>
    <view class="amount-row amount-row--strong"><text>实付金额</text><text>¥{{order.payAmount}}</text></view>
    <view wx:if="{{order.containsPreorder}}" class="amount-row"><text>到店待付尾款</text><text>¥{{order.balanceAmount}}</text></view>
  </view>

  <view class="section-card">
    <text class="card-title">菜品明细</text>
    <view wx:for="{{order.items}}" wx:key="dishId" class="item-row">
      <image class="item-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
      <view class="item-info">
        <text class="item-name">{{item.dishName}}</text>
        <text class="item-desc">{{item.specDesc}} {{item.addonDesc}}</text>
        <text class="item-desc">× {{item.quantity}}</text>
      </view>
      <text class="item-amount">¥{{item.amount}}</text>
    </view>
  </view>

  <view class="section-card">
    <text class="card-title">订单信息</text>
    <view class="amount-row"><text>订单号</text><text>{{order.orderNo}}</text></view>
    <view class="amount-row"><text>类型</text><text>{{order.orderType === 'DINE_IN' ? '到店用餐' : '自提'}}</text></view>
    <view wx:if="{{order.dineInTime}}" class="amount-row"><text>到店时间</text><text>{{order.dineInTime}}</text></view>
    <view wx:if="{{order.pickupTime}}" class="amount-row"><text>自提时间</text><text>{{order.pickupTime}}</text></view>
    <view class="amount-row"><text>备注</text><text>{{order.remark || '无'}}</text></view>
    <view class="amount-row"><text>下单时间</text><text>{{order.createTime}}</text></view>
  </view>

  <view class="section-card">
    <text class="card-title">评价</text>
    <text class="review-hint">{{order.reviewed ? '已评价，感谢你的反馈' : (order.canReview ? '本单待评价，评价可得积分' : '订单完成后可评价')}}</text>
    <view wx:if="{{order.canReview}}" class="review-btn" bindtap="onGoReview" hover-class="review-btn--hover">去评价</view>
  </view>

  <view class="section-card">
    <text class="card-title">状态日志</text>
    <view wx:for="{{order.logs}}" wx:key="createTime" class="log-row">
      <text class="log-status">{{item.fromStatus || '—'}} → {{item.toStatus}}</text>
      <text class="log-remark">{{item.remark}}</text>
      <text class="log-time">{{item.createTime}}</text>
    </view>
  </view>

</view>
<view wx:elif="{{loading}}" class="loading">加载中…</view>
</scroll-view>
  <view wx:if="{{order && (order.status === 'CREATED' || order.status === 'PAID' || order.status === 'ACCEPTED' || order.status === 'READY')}}" class="action-bar">
    <view wx:if="{{order.status === 'CREATED'}}" class="primary-btn" bindtap="onPay" hover-class="primary-btn--hover">
      {{order.containsPreorder ? '付定金 ¥' : '立即支付 ¥'}}{{order.containsPreorder ? order.depositAmount : order.payAmount}}
    </view>
    <view wx:if="{{(order.status === 'PAID' || order.status === 'ACCEPTED' || order.status === 'READY') && !order.containsPreorder}}" class="primary-btn" bindtap="onApplyRefund" hover-class="primary-btn--hover">申请退款</view>
    <view wx:if="{{order.status === 'CREATED' || order.status === 'PAID'}}" class="ghost-btn" bindtap="onCancel" hover-class="ghost-btn--hover">取消订单</view>
    <view class="ghost-btn" bindtap="onGoOrders" hover-class="ghost-btn--hover">我的订单</view>
  </view>
