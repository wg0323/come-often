.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: var(--co-space-card);
}

.title {
  color: var(--co-text-primary);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.link {
  color: var(--co-cinnabar);
  font-size: 24rpx;
}

.store-card {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--co-space-gap);
  padding: var(--co-space-card);
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-card);
  background-color: var(--co-card);
}

.store-card--hover {
  opacity: 0.88;
}

.store-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.store-name {
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.store-status {
  color: var(--co-success);
  font-size: 24rpx;
}

.store-address,
.store-phone {
  margin-top: 10rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.store-action {
  margin-top: 16rpx;
  color: var(--co-gold);
  font-size: 24rpx;
}

.tip {
  padding: 48rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}
