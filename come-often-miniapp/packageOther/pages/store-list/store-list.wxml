<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view class="head">
    <text class="title">选择门店</text>
    <text class="link" bindtap="onTapMine">我的预约</text>
  </view>

  <view
    wx:for="{{stores}}"
    wx:key="id"
    class="store-card"
    data-id="{{item.id}}"
    bindtap="onTapStore"
    hover-class="store-card--hover"
  >
    <view class="store-head">
      <text class="store-name">{{item.storeName}}</text>
      <text class="store-status">{{item.businessStatusText}}</text>
    </view>
    <text class="store-address">{{item.address}}</text>
    <text class="store-phone">{{item.phone}}</text>
    <text class="store-action">预约订座 ›</text>
  </view>

  <view wx:if="{{loading}}" class="tip">加载中…</view>
  <view wx:elif="{{loaded && stores.length === 0}}" class="tip">暂无可预约门店</view>
</view>
</scroll-view>
