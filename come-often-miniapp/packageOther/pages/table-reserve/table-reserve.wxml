<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view wx:if="{{mode === 'reschedule'}}" class="banner">
    <text>正在改期：{{reserveNo}}</text>
  </view>

  <text class="section-heading">预约日期</text>
  <scroll-view class="chips" scroll-x enhanced="{{true}}" show-scrollbar="{{false}}">
    <view
      wx:for="{{dates}}"
      wx:key="*this"
      class="chip {{selectedDate === item ? 'chip--active' : ''}}"
      data-date="{{item}}"
      bindtap="onSelectDate"
    >{{item}}</view>
  </scroll-view>

  <text class="section-heading">就餐人数</text>
  <view wx:if="{{mode === 'create'}}" class="stepper">
    <view class="stepper-btn" data-delta="-1" bindtap="onStepPeople">−</view>
    <input class="stepper-input" type="number" value="{{peopleCount}}" bindinput="onInputPeople" />
    <view class="stepper-btn" data-delta="1" bindtap="onStepPeople">+</view>
    <text class="stepper-tip">1-4 人推荐卡座，6-10 人包间，12-20 人大包间</text>
  </view>
  <text wx:else class="stepper-tip">改期沿用原单人数：{{peopleCount}} 人</text>

  <text class="section-heading">桌型</text>
  <view class="chips">
    <view
      wx:for="{{types}}"
      wx:key="code"
      class="chip {{selectedType === item.code ? 'chip--active' : ''}} {{item.disabled ? 'chip--disabled' : ''}}"
      data-code="{{item.code}}"
      data-disabled="{{item.disabled}}"
      bindtap="onSelectType"
    >{{item.label}}</view>
  </view>

  <text class="section-heading">时段</text>
  <view class="slots">
    <view
      wx:for="{{timeSlots}}"
      wx:key="timeSlot"
      class="slot {{selectedTimeSlot === item.timeSlot ? 'slot--active' : ''}} {{item.full ? 'slot--full' : ''}}"
      data-slot="{{item.timeSlot}}"
      data-full="{{item.full}}"
      bindtap="onSelectTimeSlot"
    >
      <text class="slot-time">{{item.timeSlot}}</text>
      <text class="slot-remain">{{item.remainText}}</text>
    </view>
  </view>
  <view wx:if="{{slotsEmpty && selectedType}}" class="tip">当前日期暂无可预约时段，请切换日期或联系门店</view>
  <view wx:if="{{!selectedType}}" class="tip">请先选择与人数匹配的桌型</view>

  <text class="section-heading">联系方式</text>
  <view class="form">
    <view class="form-row">
      <text class="form-label">联系人</text>
      <input class="form-input" value="{{form.contactName}}" data-field="contactName" bindinput="onInputContact" placeholder="请填写联系人" />
    </view>
    <view class="form-row">
      <text class="form-label">手机号</text>
      <input class="form-input" type="number" maxlength="11" value="{{form.contactPhone}}" data-field="contactPhone" bindinput="onInputContact" placeholder="用于到店联系" />
    </view>
    <view class="form-row">
      <text class="form-label">备注</text>
      <input class="form-input" value="{{form.remark}}" data-field="remark" bindinput="onInputContact" placeholder="生日布置 / 儿童座椅 / 忌口" />
    </view>
  </view>

  <view class="rules">
    <text class="rule-text">· 下单后{{autoConfirm ? '系统自动确认' : '需商家确认'}}，到店请出示签到码</text>
    <text class="rule-text">· 距预约不足 {{cancelLimitHours}} 小时不可取消</text>
    <text class="rule-text">· 超时 {{noShowMinutes}} 分钟未签到将自动释放时段</text>
  </view>

  <button class="submit" loading="{{submitting}}" bindtap="onSubmit">{{mode === 'reschedule' ? '确认改期' : '提交预约'}}</button>
  <view wx:if="{{loading}}" class="tip">时段加载中…</view>
</view>
</scroll-view>
