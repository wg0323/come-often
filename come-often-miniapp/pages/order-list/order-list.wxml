<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" bindscrolltolower="onReachBottom">
<view class="page">
  <view class="tabs">
    <view
      wx:for="{{tabs}}"
      wx:key="key"
      class="tab {{activeTab === item.key ? 'tab--active' : ''}}"
      data-key="{{item.key}}"
      bindtap="onTabChange"
    >{{item.label}}</view>
  </view>

  <view wx:if="{{orders.length > 0}}" class="list">
    <view
      wx:for="{{orders}}"
      wx:key="orderNo"
      class="order-card"
      data-order-no="{{item.orderNo}}"
      bindtap="onTapOrder"
      hover-class="order-card--hover"
    >
      <view class="head-row">
        <text class="order-no">{{item.orderNo}}</text>
        <text class="order-status">{{item.statusText}}</text>
      </view>
      <text class="summary">{{item.itemSummary}}</text>
      <view class="foot-row">
        <text class="type">{{item.orderType === 'DINE_IN' ? '到店用餐' : '自提'}}</text>
        <text wx:if="{{item.pickupCode}}" class="code">{{item.pickupCode}}</text>
        <text class="amount"><text class="price-symbol">¥</text><text class="price-num">{{item.payAmount}}</text></text>
      </view>
      <view class="foot-row">
        <text class="time">{{item.createTime}}</text>
        <view
          wx:if="{{item.canReview}}"
          class="review-btn"
          data-order-no="{{item.orderNo}}"
          catchtap="onGoReview"
        >去评价</view>
      </view>
    </view>
  </view>

  <view wx:elif="{{loaded && !loading}}" class="empty">
    <text class="empty-text">这个分类下还没有订单</text>
    <view class="empty-btn" bindtap="onGoDish" hover-class="empty-btn--hover">去点菜</view>
  </view>

  <view wx:if="{{loading}}" class="list-tip">加载中…</view>
  <view wx:elif="{{!hasMore && orders.length > 0}}" class="list-tip">没有更多了</view>
</view>
</scroll-view>
