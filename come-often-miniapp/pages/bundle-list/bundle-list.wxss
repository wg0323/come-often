.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.intro {
  display: flex;
  flex-direction: column;
  margin-bottom: var(--co-space-gap);
}

.intro-title {
  color: var(--co-text-primary);
  font-size: 36rpx;
  font-weight: 700;
}

.intro-desc {
  margin-top: 8rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.bundle-card {
  margin-bottom: var(--co-space-gap);
  padding: var(--co-space-card);
  border-radius: var(--co-radius-card);
  background-color: var(--co-card);
}

.head-row,
.foot-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.bundle-name {
  color: var(--co-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.bundle-stock {
  color: var(--co-gold);
  font-size: 24rpx;
}

.bundle-desc {
  display: block;
  margin-top: 12rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.item-list {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.bundle-item {
  margin-right: 16rpx;
  margin-bottom: 8rpx;
  padding: 4rpx 12rpx;
  border-radius: var(--co-radius-button);
  background-color: var(--co-bg);
  color: var(--co-text-secondary);
  font-size: 22rpx;
}

.foot-row {
  margin-top: 16rpx;
}

.price-wrap {
  display: flex;
  align-items: baseline;
  color: var(--co-cinnabar);
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 40rpx;
  font-weight: 700;
}

.origin-price {
  margin-left: 12rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-decoration: line-through;
}

.buy-btn {
  padding: 12rpx 32rpx;
  border-radius: var(--co-radius-button);
  background-color: var(--co-ink);
  color: var(--co-card);
  font-size: 26rpx;
}

.buy-btn--hover {
  opacity: 0.8;
}

.empty,
.tip {
  padding: 80rpx 0;
  color: var(--co-text-tertiary);
  font-size: 26rpx;
  text-align: center;
}
