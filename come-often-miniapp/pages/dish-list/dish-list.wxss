.layout {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

.rails {
  display: flex;
  flex: 1;
  min-height: 0;
}

.category-rail {
  /* 210rpx 才能容下「需提前预定」5 字，180rpx 会折行 */
  width: 210rpx;
  height: 100%;
  background-color: var(--co-card);
  border-right: 1rpx solid var(--co-divider);
}

.category-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 96rpx;
  padding: 0 20rpx;
  color: var(--co-text-secondary);
  font-size: 28rpx;
}

.category-name {
  flex: none;
  white-space: nowrap;
}

.category-item--active {
  background-color: var(--co-paper);
  color: var(--co-text-primary);
  font-weight: 600;
  border-left: 6rpx solid var(--co-cinnabar);
}

.dish-rail {
  flex: 1;
  height: 100%;
  padding: var(--co-space-gap);
  box-sizing: border-box;
}

.state {
  padding: 80rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.dish-card {
  display: flex;
  gap: var(--co-space-card);
  margin-bottom: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.dish-card--hover {
  opacity: 0.86;
}

/* 4:3，全站列表图统一比例 */
.dish-image-wrap {
  position: relative;
  flex: none;
  width: 200rpx;
  height: 150rpx;
  border-radius: var(--co-radius-tag);
  overflow: hidden;
}

.dish-image {
  width: 100%;
  height: 100%;
}

.badge {
  position: absolute;
  left: 0;
  top: 0;
  padding: 4rpx 10rpx;
  font-size: 20rpx;
  border-radius: var(--co-radius-tag);
}

.badge--gold {
  background-color: var(--co-gold);
  color: var(--co-card);
}

.badge--soldout {
  background-color: var(--co-danger);
  color: var(--co-card);
}

.dish-body {
  display: flex;
  flex: 1;
  flex-direction: column;
  min-width: 0;
}

.dish-name {
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.sub-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 8rpx;
}

.dish-subtitle {
  flex: 1;
  min-width: 0;
  color: var(--co-text-secondary);
  font-size: 24rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
  margin-top: 10rpx;
}

.tag {
  padding: 2rpx 8rpx;
  color: var(--co-cinnabar);
  font-size: 20rpx;
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-tag);
}

.dish-bottom {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: auto;
}

.price {
  color: var(--co-cinnabar);
  font-variant-numeric: tabular-nums;
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.member-tag {
  margin-left: 8rpx;
  padding: 0 8rpx;
  border: 1rpx solid var(--co-gold);
  border-radius: 6rpx;
  color: var(--co-gold);
  font-size: 20rpx;
  font-weight: 400;
}

.sales {
  flex: none;
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

/* 列表快捷加购：默认规格一键入车，改规格仍需进详情 */
.add-btn {
  position: relative;
  flex: none;
  width: 52rpx;
  height: 52rpx;
  background-color: var(--co-cinnabar);
  border-radius: 50%;
}

/* 加号用两根横竖条画，不用「＋」文字：全角字形基点偏低约 2~3rpx */
.add-btn::before,
.add-btn::after {
  content: '';
  position: absolute;
  left: 50%;
  top: 50%;
  background-color: var(--co-card);
  border-radius: 2rpx;
  transform: translate(-50%, -50%);
}

.add-btn::before {
  width: 22rpx;
  height: 3rpx;
}

.add-btn::after {
  width: 3rpx;
  height: 22rpx;
}

.add-btn--hover {
  opacity: 0.82;
}

/* 顶部用餐方式条 */
.mode-bar {
  display: flex;
  flex: none;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx var(--co-space-card);
  background-color: var(--co-card);
  border-bottom: 1rpx solid var(--co-divider);
}

.mode-bar--hover {
  opacity: 0.86;
}

.mode-text {
  color: var(--co-text-secondary);
  font-size: 26rpx;
}

.mode-switch {
  color: var(--co-cinnabar);
  font-size: 24rpx;
}

/* 底部外卖式购物车条 */
.cart-bar {
  display: flex;
  flex: none;
  align-items: center;
  gap: var(--co-space-gap);
  padding: 16rpx var(--co-space-card);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--co-card);
  border-top: 1rpx solid var(--co-divider);
}

.cart-bubble {
  position: relative;
  display: flex;
  flex: none;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: var(--co-ink);
}

.cart-bubble--hover,
.cart-fab--hover {
  opacity: 0.86;
}

.cart-icon {
  width: 48rpx;
  height: 48rpx;
}

.cart-badge {
  position: absolute;
  top: -8rpx;
  right: -8rpx;
  min-width: 32rpx;
  padding: 2rpx 8rpx;
  border-radius: 16rpx;
  background-color: var(--co-cinnabar);
  color: var(--co-card);
  font-size: 20rpx;
  text-align: center;
}

.cart-summary {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.cart-total {
  color: var(--co-cinnabar);
  font-size: 34rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.cart-tip {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.cart-checkout {
  padding: 16rpx 40rpx;
  border-radius: var(--co-radius-button);
  background-color: var(--co-cinnabar);
  color: var(--co-card);
  font-size: 28rpx;
}

/* 用餐方式选择弹层 */
.mode-mask {
  position: fixed;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  z-index: 110;
  display: flex;
  align-items: flex-end;
  background-color: var(--co-mask);
}

.mode-dialog {
  width: 100%;
  padding: var(--co-space-card);
  padding-bottom: calc(var(--co-space-card) + env(safe-area-inset-bottom));
  background-color: var(--co-paper);
  border-radius: var(--co-radius-card) var(--co-radius-card) 0 0;
  box-sizing: border-box;
}

.mode-title {
  display: block;
  margin-bottom: var(--co-space-gap);
  font-size: 32rpx;
  font-weight: 600;
}

.mode-options {
  display: flex;
  gap: var(--co-space-gap);
}

.mode-option {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border: 2rpx solid var(--co-divider);
  border-radius: var(--co-radius-card);
}

.mode-option--active {
  border-color: var(--co-cinnabar);
}

.option-title {
  font-size: 30rpx;
  font-weight: 600;
}

.option-desc {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.field-label {
  display: block;
  margin-top: var(--co-space-gap);
  color: var(--co-text-secondary);
  font-size: 26rpx;
}

.table-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: var(--co-space-gap);
}

.table-row .field-label {
  margin-top: 0;
}

.table-code {
  color: var(--co-cinnabar);
  font-size: 28rpx;
  font-weight: 600;
}

.scan-btn,
.mode-confirm {
  margin-top: var(--co-space-gap);
  padding: 20rpx 0;
  border-radius: var(--co-radius-button);
  background-color: var(--co-ink);
  color: var(--co-card);
  font-size: 28rpx;
  text-align: center;
}

.table-input {
  margin-top: var(--co-space-gap);
  padding: 16rpx var(--co-space-card);
  background-color: var(--co-card);
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-button);
  font-size: 26rpx;
}

.picker-row {
  display: flex;
  gap: var(--co-space-gap);
  margin-top: 12rpx;
}

.picker {
  flex: 1;
  padding: 16rpx var(--co-space-card);
  background-color: var(--co-card);
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-button);
  font-size: 26rpx;
  text-align: center;
}

.mode-tip {
  display: block;
  margin-top: 12rpx;
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.mode-confirm {
  background-color: var(--co-cinnabar);
}

.mode-cancel {
  margin-top: var(--co-space-gap);
  color: var(--co-text-tertiary);
  font-size: 26rpx;
  text-align: center;
}
