<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view wx:if="{{items.length > 0}}" class="list">
    <view wx:for="{{items}}" wx:key="itemId" class="cart-card {{item.invalid ? 'cart-card--invalid' : ''}}">
      <view
        class="check {{item.selected ? 'check--active' : ''}}"
        data-item-id="{{item.itemId}}"
        bindtap="onToggleItem"
        hover-class="check--hover"
      >{{item.selected ? '✓' : ''}}</view>
      <image class="cart-image" src="{{item.imageUrl}}" mode="aspectFill" lazy-load />
      <view class="cart-info">
        <view class="title-row">
          <text class="dish-name">{{item.dishName}}</text>
          <text wx:if="{{item.preorder}}" class="preorder-tag">需提前预定</text>
        </view>
        <text class="desc">{{item.specDesc}}{{item.addonDesc}}</text>
        <text wx:if="{{item.invalid}}" class="invalid-text">{{item.invalidReason}}</text>
        <view class="bottom-row">
          <view class="price"><text class="price-symbol">¥</text><text class="price-num">{{item.unitPrice}}</text></view>
          <view class="quantity">
            <view class="quantity-btn" data-item-id="{{item.itemId}}" data-delta="-1" bindtap="onChangeQuantity" hover-class="quantity-btn--hover">－</view>
            <text class="quantity-value">{{item.quantity}}</text>
            <view class="quantity-btn" data-item-id="{{item.itemId}}" data-delta="1" bindtap="onChangeQuantity" hover-class="quantity-btn--hover">＋</view>
            <view class="remove-btn" data-item-id="{{item.itemId}}" bindtap="onRemove">删除</view>
          </view>
        </view>
      </view>
    </view>
    <text class="amount-note">行金额与合计均由服务端试算，最终金额以确认订单页为准</text>
  </view>

  <view wx:elif="{{!loading}}" class="empty">
    <text class="empty-text">购物车还是空的</text>
    <view class="empty-btn" bindtap="onGoDish" hover-class="empty-btn--hover">去点菜</view>
  </view>

</view>
</scroll-view>
  <view wx:if="{{cart && items.length > 0}}" class="action-bar">
    <view class="action-price">
      <text class="action-label">购物车合计</text>
      <text class="price-symbol">¥</text>
      <text class="price-num">{{cart.totalAmount}}</text>
    </view>
    <view class="primary-btn" bindtap="onCheckout" hover-class="primary-btn--hover">去结算</view>
  </view>
