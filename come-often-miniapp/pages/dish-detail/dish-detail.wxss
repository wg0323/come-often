.page {
  min-height: 100vh;
  padding-bottom: 160rpx;
  box-sizing: border-box;
}

.gallery-wrap {
  position: relative;
  width: 100%;
}

/* 3:2，详情首图统一比例 */
.gallery {
  width: 100%;
  height: 500rpx;
}

.gallery-image {
  width: 100%;
  height: 100%;
}

.gallery-badge {
  position: absolute;
  left: var(--co-space-page);
  top: var(--co-space-page);
  padding: 8rpx 16rpx;
  background-color: var(--co-gold);
  color: var(--co-card);
  font-size: 24rpx;
  letter-spacing: 1rpx;
  border-radius: var(--co-radius-tag);
}

.gallery-dots {
  position: absolute;
  right: var(--co-space-page);
  bottom: 20rpx;
  display: flex;
  gap: 8rpx;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  background-color: var(--co-card);
  border-radius: var(--co-radius-tag);
  opacity: 0.6;
}

.dot--active {
  background-color: var(--co-cinnabar);
  opacity: 1;
}

.detail-card,
.option-card,
.info-card,
.quote-card {
  margin: var(--co-space-gap) var(--co-space-page) 0;
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.title-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.dish-name {
  color: var(--co-text-primary);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.soldout {
  color: var(--co-danger);
  font-size: 24rpx;
}

.subtitle,
.description {
  display: block;
  margin-top: 10rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.price-row {
  display: flex;
  align-items: baseline;
  gap: 6rpx;
  margin-top: 16rpx;
  color: var(--co-cinnabar);
  font-variant-numeric: tabular-nums;
}

.price-symbol {
  font-size: 24rpx;
}

.price-num {
  font-size: 36rpx;
  font-weight: 700;
}

.sales,
.craft {
  margin-left: 16rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.craft {
  color: var(--co-gold);
}

.preorder-note {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
  margin-top: 20rpx;
  padding: var(--co-space-card);
  border: 2rpx solid var(--co-gold);
  border-radius: var(--co-radius-button);
}

.note-title {
  color: var(--co-gold);
  font-size: 28rpx;
  font-weight: 600;
}

.note-sub {
  color: var(--co-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.option-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.option-title,
.info-title {
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.option-hint {
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.option-row,
.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.option-chip {
  display: flex;
  align-items: center;
  gap: 8rpx;
  min-height: 64rpx;
  padding: 0 20rpx;
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-button);
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.option-chip--active {
  border-color: var(--co-cinnabar);
  color: var(--co-cinnabar);
}

.option-chip--hover,
.quantity-btn--hover,
.primary-btn--hover {
  opacity: 0.8;
}

.option-delta {
  color: var(--co-text-tertiary);
  font-size: 20rpx;
}

.info-text {
  display: block;
  margin: 12rpx 0 20rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.tag {
  padding: 4rpx 12rpx;
  color: var(--co-cinnabar);
  font-size: 20rpx;
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-tag);
}

.quote-row {
  display: flex;
  justify-content: space-between;
  margin-top: 12rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.cart-fab {
  position: fixed;
  right: var(--co-space-page);
  bottom: 200rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background-color: var(--co-ink);
  box-shadow: 0 2rpx 12rpx var(--co-divider);
}

.cart-fab-icon {
  width: 48rpx;
  height: 48rpx;
}

.action-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  gap: var(--co-space-gap);
  padding: 16rpx var(--co-space-page);
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: var(--co-card);
  box-shadow: 0 -2rpx 12rpx var(--co-divider);
  box-sizing: border-box;
}

.quantity {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.quantity-btn {
  width: 56rpx;
  height: 56rpx;
  line-height: 56rpx;
  border: 1rpx solid var(--co-divider);
  border-radius: var(--co-radius-button);
  color: var(--co-text-primary);
  text-align: center;
}

.quantity-value {
  min-width: 32rpx;
  color: var(--co-text-primary);
  font-variant-numeric: tabular-nums;
  text-align: center;
}

.action-price {
  flex: 1;
  color: var(--co-cinnabar);
  font-variant-numeric: tabular-nums;
}

.primary-btn {
  min-width: 240rpx;
  height: 88rpx;
  line-height: 88rpx;
  background-color: var(--co-ink);
  color: var(--co-card);
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  border-radius: var(--co-radius-button);
}

.primary-btn--gold {
  background-color: var(--co-gold);
}

.primary-btn--disabled {
  background-color: var(--co-text-tertiary);
}

.rating-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-top: 12rpx;
}

.rating-score {
  color: var(--co-gold);
  font-size: 28rpx;
  font-weight: 600;
}

.rating-count {
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.review-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.review-all {
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.review-all--hover {
  opacity: 0.7;
}

.review-item {
  margin-top: 20rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid var(--co-divider);
}

.review-item-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.review-nickname {
  color: var(--co-text-primary);
  font-size: 26rpx;
  font-weight: 600;
}

.review-time {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.review-stars {
  display: block;
  margin-top: 6rpx;
  color: var(--co-gold);
  font-size: 22rpx;
}

.review-content {
  display: block;
  margin-top: 10rpx;
  color: var(--co-text-primary);
  font-size: 26rpx;
  line-height: 1.6;
}

.review-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 12rpx;
}

/* 评价图沿用 4:3，与列表图同比例 */
.review-image {
  width: 160rpx;
  height: 120rpx;
  border-radius: var(--co-radius-tag);
}

.loading {
  padding: 120rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}
