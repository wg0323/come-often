<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view class="member-card">
    <view class="member-head">
      <view class="avatar">{{avatarText}}</view>
      <view class="member-info">
        <text class="member-name">{{nickname}}</text>
        <text class="member-phone">已登录 · {{phone}}</text>
      </view>
    </view>
    <view class="level-badge" bindtap="onTapLevel" hover-class="card--hover">{{levelName}} ›</view>
  </view>

  <view class="asset-card">
    <view class="asset-main">
      <text class="asset-label">储值余额</text>
      <view class="asset-value">
        <text class="asset-symbol">¥</text>
        <text class="asset-num">{{balanceAmount}}</text>
      </view>
    </view>
    <view class="asset-action" bindtap="onTapRecharge" hover-class="card--hover">立即充值</view>
  </view>

  <view class="quick-row">
    <view
      class="quick-card"
      data-url="/packageMember/pages/coupon-wallet/coupon-wallet"
      bindtap="onTapEntry"
      hover-class="card--hover"
    >
      <text class="quick-label">我的券</text>
      <text class="quick-value">{{couponCount}} 张可用</text>
    </view>
    <view
      class="quick-card"
      data-url="/packageMember/pages/points-record/points-record"
      bindtap="onTapEntry"
      hover-class="card--hover"
    >
      <text class="quick-label">我的积分</text>
      <text class="quick-value">{{points}} 分</text>
    </view>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">我的订单</text>
      <text class="section-more" bindtap="onTapEntry" data-url="/pages/order-list/order-list">全部 ›</text>
    </view>
    <view class="entry-grid entry-grid--four">
      <view
        wx:for="{{orderEntries}}"
        wx:key="key"
        class="entry"
        data-url="{{item.url}}"
        bindtap="onTapEntry"
        hover-class="card--hover"
      >
        <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">到店服务</text>
    <view class="entry-grid entry-grid--four">
      <view
        wx:for="{{serviceEntries}}"
        wx:key="key"
        class="entry"
        data-url="{{item.url}}"
        bindtap="onTapEntry"
        hover-class="card--hover"
      >
        <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section">
    <text class="section-title">权益与记录</text>
    <view class="entry-grid entry-grid--four">
      <view
        wx:for="{{benefitEntries}}"
        wx:key="key"
        class="entry"
        data-url="{{item.url}}"
        bindtap="onTapEntry"
        hover-class="card--hover"
      >
        <image class="entry-icon" src="{{item.icon}}" mode="aspectFit" />
        <text class="entry-label">{{item.label}}</text>
      </view>
    </view>
  </view>

  <view class="section section--logout" bindtap="onTapLogout" hover-class="card--hover">
    <text class="logout-text">退出登录</text>
  </view>
</view>
</scroll-view>
