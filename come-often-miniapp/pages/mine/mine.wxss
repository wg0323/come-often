.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.member-card {
  padding: var(--co-space-card);
  background-color: var(--co-ink);
  border-radius: var(--co-radius-card);
  color: var(--co-card);
}

.member-head {
  display: flex;
  align-items: center;
  gap: var(--co-space-gap);
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border: 2rpx solid var(--co-gold);
  border-radius: 50%;
  color: var(--co-gold);
  font-size: 40rpx;
  text-align: center;
}

.member-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
}

.member-name {
  font-size: 32rpx;
  font-weight: 600;
}

.member-phone {
  color: var(--co-divider);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.member-foot {
  display: flex;
  margin-top: var(--co-space-card);
  padding-top: var(--co-space-card);
  border-top: 1rpx solid rgba(255, 255, 255, 0.16);
}

.stat {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 6rpx;
}

.stat--link {
  align-items: flex-end;
}

.stat-num {
  color: var(--co-gold);
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.stat-level {
  color: var(--co-gold);
  font-size: 28rpx;
  font-weight: 600;
}

.stat-label {
  color: var(--co-divider);
  font-size: 22rpx;
}

.cell-group {
  margin-top: var(--co-space-gap);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
  overflow: hidden;
}

.cell {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 88rpx;
  padding: 20rpx var(--co-space-card);
  box-sizing: border-box;
  border-bottom: 1rpx solid var(--co-divider);
}

.cell:last-child {
  border-bottom: none;
}

.cell--hover,
.entry--hover {
  opacity: 0.86;
}

.cell-body {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.cell-label {
  color: var(--co-text-primary);
  font-size: 28rpx;
}

.cell-desc {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.cell-arrow {
  color: var(--co-text-tertiary);
  font-size: 32rpx;
}

.cell--logout {
  justify-content: center;
}

.cell-label--logout {
  color: var(--co-danger);
  font-size: 28rpx;
}
