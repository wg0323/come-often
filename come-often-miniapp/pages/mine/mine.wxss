.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

/* 会员身份卡：深墨绿底 + 金色等级徽章 */
.member-card {
  display: flex;
  align-items: center;
  gap: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-ink);
  border-radius: var(--co-radius-card);
  color: var(--co-card);
}

.member-head {
  display: flex;
  flex: 1;
  align-items: center;
  gap: var(--co-space-gap);
  min-width: 0;
}

.avatar {
  flex: none;
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  border: 2rpx solid var(--co-gold);
  border-radius: 50%;
  color: var(--co-gold);
  font-size: 40rpx;
  text-align: center;
}

.member-info {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  min-width: 0;
}

.member-name {
  font-size: 32rpx;
  font-weight: 600;
}

.member-phone {
  color: var(--co-divider);
  font-size: 22rpx;
  font-variant-numeric: tabular-nums;
}

.level-badge {
  flex: none;
  padding: 8rpx 16rpx;
  border: 1rpx solid var(--co-gold);
  border-radius: var(--co-radius-tag);
  color: var(--co-gold);
  font-size: 22rpx;
}

/* 资产卡：余额与充值入口 */
.asset-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.asset-main {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.asset-label {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.asset-value {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
  color: var(--co-ink);
}

.asset-symbol {
  font-size: 24rpx;
}

.asset-num {
  font-size: 44rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.asset-action {
  padding: 12rpx 28rpx;
  border: 1rpx solid var(--co-gold);
  border-radius: var(--co-radius-button);
  color: var(--co-gold);
  font-size: 24rpx;
}

/* 双列快捷卡：券与积分 */
.quick-row {
  display: flex;
  gap: var(--co-space-gap);
  margin-top: var(--co-space-gap);
}

.quick-card {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 8rpx;
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.quick-label {
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.quick-value {
  color: var(--co-ink);
  font-size: 32rpx;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

/* 分组卡：标题 + 宫格入口 */
.section {
  margin-top: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.section-title {
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.section-more {
  color: var(--co-text-tertiary);
  font-size: 22rpx;
}

.entry-grid {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.entry-grid--four .entry {
  width: 25%;
}

.entry {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 0;
  box-sizing: border-box;
}

.entry-icon {
  width: 56rpx;
  height: 56rpx;
}

.entry-label {
  color: var(--co-text-secondary);
  font-size: 22rpx;
}

.section--logout {
  display: flex;
  justify-content: center;
}

.logout-text {
  color: var(--co-danger);
  font-size: 28rpx;
}

.card--hover {
  opacity: 0.86;
}
