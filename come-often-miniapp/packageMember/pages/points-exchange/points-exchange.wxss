.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.summary-card {
  padding: var(--co-space-card);
  background-color: var(--co-ink);
  border-radius: var(--co-radius-card);
  color: var(--co-card);
}

.summary-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.summary-label {
  color: rgba(255, 255, 255, 0.72);
  font-size: 26rpx;
}

.summary-num {
  font-size: 56rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.summary-tip {
  display: block;
  margin-top: 12rpx;
  color: rgba(255, 255, 255, 0.66);
  font-size: 22rpx;
  line-height: 1.6;
}

.list {
  margin-top: var(--co-space-gap);
}

.dish-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
  border: 1rpx solid var(--co-divider);
}

.dish-body {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.dish-name {
  color: var(--co-text-primary);
  font-size: 30rpx;
  font-weight: 600;
}

.dish-meta {
  margin-top: 8rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.dish-badge {
  align-self: flex-start;
  margin-top: 8rpx;
  padding: 2rpx 10rpx;
  border: 1rpx solid var(--co-gold);
  border-radius: 6rpx;
  color: var(--co-gold);
  font-size: 20rpx;
}

.exchange-btn {
  flex: none;
  min-width: 132rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  margin-left: var(--co-space-gap);
  background-color: var(--co-cinnabar);
  color: var(--co-card);
  font-size: 26rpx;
  text-align: center;
  border-radius: var(--co-radius-button);
}

.exchange-btn--disabled {
  background-color: var(--co-divider);
  color: var(--co-text-tertiary);
}

.entry--hover {
  opacity: 0.86;
}

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
}

.empty-text {
  color: var(--co-text-secondary);
  font-size: 28rpx;
}

.empty-tip {
  margin-top: 12rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.loading {
  padding: 32rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}
