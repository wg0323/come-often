.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.coupon-card {
  display: flex;
  flex-direction: column;
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
  border: 2rpx solid var(--co-gold);
}

.coupon-face {
  color: var(--co-cinnabar);
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.coupon-name {
  margin-top: 12rpx;
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.coupon-cond {
  margin-top: 8rpx;
  color: var(--co-text-secondary);
  font-size: 24rpx;
}

.coupon-expire {
  margin-top: 8rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.code-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: var(--co-space-gap);
  padding: 48rpx var(--co-space-card);
  background-color: var(--co-ink);
  border-radius: var(--co-radius-card);
}

.code-card--hover {
  opacity: 0.9;
}

.code-label {
  color: var(--co-paper);
  font-size: 24rpx;
  opacity: 0.72;
}

.code-value {
  margin-top: 24rpx;
  color: var(--co-card);
  font-size: 48rpx;
  font-weight: 700;
  letter-spacing: 4rpx;
  font-variant-numeric: tabular-nums;
}

.code-tip {
  margin-top: 24rpx;
  color: var(--co-paper);
  font-size: 24rpx;
  opacity: 0.72;
}

.note-card {
  margin-top: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
}

.note-line {
  display: block;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  line-height: 1.7;
}

.error {
  padding: 120rpx 0;
  color: var(--co-text-secondary);
  font-size: 28rpx;
  text-align: center;
}

.loading {
  padding: 120rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

/* 浮层：全屏放大券码，阴影与深底只用于浮层 */
.overlay {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background-color: var(--co-ink);
}

.overlay-code {
  color: var(--co-card);
  font-size: 72rpx;
  font-weight: 700;
  letter-spacing: 6rpx;
  font-variant-numeric: tabular-nums;
  text-align: center;
  padding: 0 var(--co-space-page);
}

.overlay-tip {
  margin-top: 40rpx;
  color: var(--co-paper);
  font-size: 24rpx;
  opacity: 0.72;
}
