.page {
  min-height: 100vh;
  padding: var(--co-space-page);
  box-sizing: border-box;
}

.level-card {
  display: flex;
  flex-direction: column;
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
  border: 2rpx solid var(--co-gold);
}

.level-code {
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

.level-name {
  margin-top: 8rpx;
  color: var(--co-gold);
  font-size: 40rpx;
  font-weight: 600;
  letter-spacing: 2rpx;
}

.level-metrics {
  display: flex;
  gap: var(--co-space-gap);
  margin-top: var(--co-space-card);
  padding-top: 16rpx;
  border-top: 1rpx solid var(--co-divider);
}

.metric {
  display: flex;
  flex: 1;
  flex-direction: column;
}

.metric-num {
  color: var(--co-text-primary);
  font-size: 36rpx;
  font-weight: 700;
  font-variant-numeric: tabular-nums;
}

.metric-label {
  margin-top: 8rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.level-next {
  margin-top: var(--co-space-card);
}

.next-text {
  color: var(--co-text-secondary);
  font-size: 24rpx;
  line-height: 1.6;
}

.section-heading {
  display: block;
  margin-top: 40rpx;
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.level-list {
  margin-top: var(--co-space-gap);
}

.level-row {
  margin-bottom: var(--co-space-gap);
  padding: var(--co-space-card);
  background-color: var(--co-card);
  border-radius: var(--co-radius-card);
  border: 1rpx solid var(--co-divider);
}

.level-row--current {
  border-color: var(--co-gold);
}

.row-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.row-name {
  color: var(--co-text-primary);
  font-size: 32rpx;
  font-weight: 600;
}

.row-code {
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.row-body {
  display: flex;
  gap: var(--co-space-gap);
  margin-top: 12rpx;
}

.row-cond {
  color: var(--co-text-secondary);
  font-size: 24rpx;
  font-variant-numeric: tabular-nums;
}

.row-benefit {
  display: block;
  margin-top: 12rpx;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
}

.loading {
  padding: 32rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  text-align: center;
}

.level-tip {
  display: block;
  padding: 24rpx 0;
  color: var(--co-text-tertiary);
  font-size: 24rpx;
  line-height: 1.6;
}
