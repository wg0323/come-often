.filters {
  display: flex;
  margin-bottom: var(--mk-space-card);
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--mk-touch-min);
  padding: 0 var(--mk-space-card);
  border-radius: var(--mk-radius-card);
  background-color: var(--mk-card);
  color: var(--mk-text);
  font-size: 26rpx;
}

.reserve-name {
  color: var(--mk-text);
  font-size: 30rpx;
  font-weight: 600;
}

.reserve-remark {
  display: block;
  margin-top: var(--mk-space-gap);
  color: var(--mk-text-secondary);
  font-size: 26rpx;
}

.actions {
  margin-top: var(--mk-space-card);
}

.list-end {
  margin-top: var(--mk-space-card);
  text-align: center;
}

.card + .card {
  margin-top: var(--mk-space-gap);
}
