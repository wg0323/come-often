<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}" refresher-enabled="{{true}}" refresher-triggered="{{refresherTriggered}}" bindrefresherrefresh="onRefresherRefresh">
<view class="page">
  <view class="filters">
    <picker mode="date" value="{{date}}" bindchange="onDateChange">
      <view class="filter">{{date}}</view>
    </picker>
    <view class="legend">
      <text class="legend-item legend-item--idle">空闲</text>
      <text class="legend-item legend-item--busy">占用</text>
      <text class="legend-item legend-item--booked">已预约</text>
    </view>
  </view>

  <view class="grid">
    <view
      wx:for="{{tables}}"
      wx:key="tableId"
      class="cell {{item.statusClass}}"
      data-tableid="{{item.tableId}}"
      bindtap="onTapCell"
    >
      <view class="cell-head">
        <text class="cell-no">{{item.tableNo}}</text>
        <text class="cell-status">{{item.statusText}}</text>
      </view>
      <text class="cell-type">{{item.tableTypeText}} · {{item.capacity}} 人</text>
      <view wx:if="{{item.isPrivate}}" class="cell-private">
        <text wx:if="{{item.contactText}}">预约人：{{item.contactText}}</text>
        <text wx:if="{{item.peopleText}}">{{item.peopleText}} · {{item.timeText}}</text>
        <text wx:if="{{!item.contactText}}" class="muted">暂无绑定预约</text>
      </view>
    </view>
  </view>

  <view wx:if="{{!loading && tables.length === 0}}" class="empty">没有桌台数据</view>
  <view class="muted board-tip">未绑定桌号的预约只计入时段容量，不在格子上显示。</view>
</view>
</scroll-view>
