.filters {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: var(--mk-space-card);
}

.filter {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: var(--mk-touch-min);
  padding: 0 var(--mk-space-card);
  border-radius: var(--mk-radius-card);
  background-color: var(--mk-card);
  color: var(--mk-text);
  font-size: 26rpx;
}

.legend {
  display: flex;
  gap: var(--mk-space-gap);
}

.legend-item {
  font-size: 24rpx;
}

.legend-item--idle {
  color: var(--mk-text-secondary);
}

.legend-item--busy {
  color: var(--mk-status-pending);
}

.legend-item--booked {
  color: var(--mk-status-ready);
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: var(--mk-space-gap);
}

.cell {
  width: calc((100% - var(--mk-space-gap)) / 2);
  padding: var(--mk-space-card);
  border-radius: var(--mk-radius-card);
  background-color: var(--mk-card);
  box-sizing: border-box;
  border-left: 8rpx solid var(--mk-divider);
}

.cell--idle {
  border-left-color: var(--mk-divider);
}

.cell--busy {
  border-left-color: var(--mk-status-pending);
}

.cell--booked {
  border-left-color: var(--mk-status-ready);
}

.cell-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.cell-no {
  color: var(--mk-text);
  font-size: 32rpx;
  font-weight: 700;
}

.cell-status {
  color: var(--mk-text-secondary);
  font-size: 24rpx;
}

.cell-type {
  display: block;
  margin-top: 6rpx;
  color: var(--mk-text-secondary);
  font-size: 24rpx;
}

.cell-private {
  display: flex;
  flex-direction: column;
  margin-top: 8rpx;
  color: var(--mk-text);
  font-size: 24rpx;
}

.board-tip {
  margin-top: var(--mk-space-card);
  text-align: center;
}
