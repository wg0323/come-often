.result {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  padding: var(--mk-space-page);
  box-sizing: border-box;
  color: var(--mk-text-inverse);
}

.result--success {
  background-color: var(--mk-status-ready);
}

.result--fail {
  background-color: var(--mk-status-pending);
}

.result-head {
  padding: 64rpx 0 48rpx;
}

.result-title {
  display: block;
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.result-message {
  display: block;
  margin-top: 20rpx;
  font-size: 30rpx;
  line-height: 1.5;
}

.result-type {
  display: inline-block;
  margin-top: 20rpx;
  padding: 4rpx 16rpx;
  border-radius: var(--mk-radius-tag);
  border: 1rpx solid var(--mk-text-inverse);
  font-size: 24rpx;
}

.result-body {
  padding: var(--mk-space-card);
  border-radius: var(--mk-radius-card);
  background-color: var(--mk-card);
  color: var(--mk-text);
}

.result-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 12rpx 0;
}

.result-label {
  color: var(--mk-text-secondary);
  font-size: 26rpx;
}

.result-value {
  max-width: 420rpx;
  color: var(--mk-text);
  font-size: 28rpx;
  text-align: right;
}

.result-actions {
  margin-top: auto;
  padding-top: 48rpx;
}

.result-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: var(--mk-button-height);
  border-radius: var(--mk-radius-button);
  background-color: var(--mk-card);
  color: var(--mk-text);
  font-size: 32rpx;
  font-weight: 600;
}

.result-btn + .result-btn {
  margin-top: var(--mk-space-card);
}

.result-btn--ghost {
  border: 1rpx solid var(--mk-text-inverse);
  background-color: transparent;
  color: var(--mk-text-inverse);
}
