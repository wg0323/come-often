<scroll-view class="page-scroll" scroll-y enhanced="{{true}}" show-scrollbar="{{false}}">
<view class="page">
  <view class="card profile">
    <view class="profile-head">
      <text class="profile-name">{{realName || '未命名员工'}}</text>
      <text class="role-tag">{{roleText || '—'}}</text>
    </view>
    <view class="divider"></view>
    <view class="row">
      <text class="label">账号</text>
      <text class="value">{{username}}</text>
    </view>
    <view class="row">
      <text class="label">门店</text>
      <text class="value">{{storeText || '—'}}</text>
    </view>
    <view class="row">
      <text class="label">权限点</text>
      <text class="value">{{permissionCount}} 个</text>
    </view>
  </view>

  <view class="card">
    <view class="btn btn--ghost" bindtap="onTapClearCache">清除本地缓存</view>
    <view class="btn btn--danger" bindtap="onTapLogout">退出登录</view>
  </view>

  <view class="muted mine-tip">商家端只做店里站着要用的事，菜品编辑、报表与权限配置请回 PC 后台。</view>
</view>
</scroll-view>
